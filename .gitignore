.DS_Store

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
env/
venv/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Data, models, and logs
*.csv
*.pkl
*.h5
*.log
*.zip
*.npy

# ...except the small CMAPSS sample CSVs checked in for demoing the app and
# tests (training_data.csv / test_data.csv are already tracked; this just
# makes that intentional instead of an unexplained exception to the *.csv
# rule above). Large/generated CSVs should still not be added -- if you need
# one tracked, add it explicitly rather than widening this pattern.
!training_data.csv
!test_data.csv

# Environment / secrets
.env
*.secret
*.key

# Build & dist artifacts
build/
dist/
*.egg-info/

# IDE / Editor files
.vscode/
.idea/

# Project-specific ignores
RUL Demo.mp4
Damage Propagation Modeling.pdf
*.docx
lightgbm_model.pkl

